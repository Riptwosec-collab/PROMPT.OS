# Server-only secret. Never prefix this with NEXT_PUBLIC_.
OPENAI_API_KEY=

# Safe to expose in the browser; Supabase RLS protects user rows.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secure default: AI route requires a verified Supabase user.
# Set true only for isolated local development; never enable on a public deployment.
PROMPT_OS_ALLOW_UNAUTHENTICATED_AI=false
