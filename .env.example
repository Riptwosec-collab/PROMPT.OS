# Server-only secret. Never prefix this with NEXT_PUBLIC_.
OPENAI_API_KEY=

# Safe to expose in the browser; Supabase RLS protects user rows.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secure default: AI route requires a verified Supabase user.
# Set true only for isolated local development; never enable on a public deployment.
PROMPT_OS_ALLOW_UNAUTHENTICATED_AI=false

# Prompt.OS V5 rollout flags. These are public, non-secret toggles.
# Keep production defaults off until each V5 phase passes its release gates.
NEXT_PUBLIC_V5_WORKSPACE=false
NEXT_PUBLIC_V5_SYNC=false
NEXT_PUBLIC_V5_EVALUATION=false
NEXT_PUBLIC_V5_ANALYTICS=false
